# =============================================================================
# Resident Health Command Center - Local Environment Configuration
# =============================================================================

# Database connection string (PostgreSQL)
# Local database (running via docker-compose)
DATABASE_URL=postgresql://postgres:password@rhcc-db:5432/rhcc

# App Environment (development | production)
NODE_ENV=development

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Application Name
APP_NAME=ai-opti-nextjs-starter

# SMTP Configuration (For Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@clinic.local

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Feature Flags
NEXT_PUBLIC_FF_AI_TRIAGE=false
NEXT_PUBLIC_FF_EMAIL_REMINDERS=false

