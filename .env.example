# =============================================================================
# Resident Health Command Center - Local Environment Configuration
# =============================================================================

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================

# Supabase URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database connection string (PostgreSQL)
# Local database (running via docker-compose)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rhcc


# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES (Defaults provided in code)
# =============================================================================

# App Environment (development | production)
NODE_ENV=development

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Application Name
APP_NAME=ai-opti-nextjs-starter

# SMTP Configuration (For Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
